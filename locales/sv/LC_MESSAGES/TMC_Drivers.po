#~ "driver_SGT: -64  # -64 is most sensitive value, 63 is least sensitive\n"
#~ "...\n"
#~ "\n"
#~ "[stepper_x]\n"
#~ "endstop_pin: tmc2130_stepper_x:virtual_endstop\n"
#~ "homing_retract_dist: 0\n"
#~ "...\n"
#~ msgstr ""

#~ msgid ""
