#~ "  {% set svv = printer.save_variables.variables %}\n"
#~ "  ACTIVATE_EXTRUDER extruder={svv.currentextruder}\n"
#~ msgstr ""

#~ msgid ""
#~ "[gcode_macro clean_nozzle]\n"
#~ "gcode:\n"
#~ "  {% set wipe_count = 8 %}\n"
#~ "  SAVE_GCODE_STATE NAME=clean_nozzle_state\n"
