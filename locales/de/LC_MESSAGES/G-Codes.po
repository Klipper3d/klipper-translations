msgstr "`BUZZ_FILTER_DELAY=<1|2>`"

#: docs/G-Codes.md:block 250 (unordered list)
msgid "`NOTCH_FILTER_FREQUENCIES=<list of frequency_hz>`"
msgstr "`NOTCH_FILTER_FREQUENCIES=<list of frequency_hz>`"

