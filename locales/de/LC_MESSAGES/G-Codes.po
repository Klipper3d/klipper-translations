msgstr "`DRIFT_FILTER_CUTOFF_FREQUENCY=<frequency_hz>`"

#: docs/G-Codes.md:block 250 (unordered list)
msgid "`DRIFT_FILTER_DELAY=<1|2>`"
msgstr "`DRIFT_FILTER_DELAY=<1|2>`"

#: docs/G-Codes.md:block 250 (unordered list)
msgid "`BUZZ_FILTER_CUTOFF_FREQUENCY=<frequency_hz>`"
msgstr "`BUZZ_FILTER_CUTOFF_FREQUENCY=<frequency_hz>`"

#: docs/G-Codes.md:block 250 (unordered list)
